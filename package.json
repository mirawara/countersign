{
  "name": "countersign",
  "displayName": "Countersign",
  "icon": "media/countersign-icon-256.png",
  "galleryBanner": {
    "color": "#1F1D1A",
    "theme": "dark"
  },
  "description": "A local VS Code sidebar chat for Claude and Codex, with plan approval and a Claude implementation and Codex review workflow.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mirawara/countersign.git"
  },
  "bugs": {
    "url": "https://github.com/mirawara/countersign/issues"
  },
  "homepage": "https://github.com/mirawara/countersign#readme",
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "ai",
    "code-review",
    "chat",
    "agent"
  ],
  "version": "0.1.0",
  "publisher": "mirawara",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "activationEvents": [
    "onCommand:countersign.startWorkflow",
    "onCommand:countersign.cancelWorkflow",
    "onCommand:countersign.showStatus",
    "onCommand:countersign.showDiagnostics",
    "onCommand:countersign.verifyClaudeGate",
    "onCommand:countersign.showDiff",
    "onCommand:countersign.showReview",
    "onCommand:countersign.showCheckResults",
    "onView:countersign.chat",
    "onCommand:countersign.openChat",
    "onCommand:countersign.newChat",
    "onCommand:countersign.clearChatHistory",
    "onCommand:countersign.verifyClaudeChatGate"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "countersign",
          "title": "Countersign",
          "icon": "media/countersign-mark.svg"
        }
      ]
    },
    "views": {
      "countersign": [
        {
          "id": "countersign.chat",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "countersign.startWorkflow",
        "title": "Countersign: Start Workflow"
      },
      {
        "command": "countersign.cancelWorkflow",
        "title": "Countersign: Cancel Workflow"
      },
      {
        "command": "countersign.showStatus",
        "title": "Countersign: Show Workflow Status"
      },
      {
        "command": "countersign.showDiagnostics",
        "title": "Countersign: Show Diagnostics"
      },
      {
        "command": "countersign.verifyClaudeGate",
        "title": "Countersign: Verify Claude Settings Isolation"
      },
      {
        "command": "countersign.showDiff",
        "title": "Countersign: Show Workflow Diff"
      },
      {
        "command": "countersign.showReview",
        "title": "Countersign: Show Review Details"
      },
      {
        "command": "countersign.showCheckResults",
        "title": "Countersign: Show Check Results"
      },
      {
        "command": "countersign.openChat",
        "title": "Countersign: Open Chat"
      },
      {
        "command": "countersign.newChat",
        "title": "Countersign: New Chat"
      },
      {
        "command": "countersign.clearChatHistory",
        "title": "Countersign: Clear Chat History"
      },
      {
        "command": "countersign.verifyClaudeChatGate",
        "title": "Countersign: Verify Claude Chat Isolation"
      }
    ],
    "configuration": {
      "title": "Countersign",
      "properties": {
        "countersign.executionPermission": {
          "type": "string",
          "enum": ["askBeforeChange", "fullAccess"],
          "default": "askBeforeChange",
          "description": "After mandatory plan approval: ask before Claude changes, commands or network tools, or grant full system access for the task. Sidebar selection overrides this setting."
        },
        "countersign.claudeExecutable": {
          "type": "string",
          "default": "claude",
          "description": "Claude CLI executable name or path. Real execution requires an exact-version settings-source gate."
        },
        "countersign.codexExecutable": {
          "type": "string",
          "default": "codex",
          "description": "Codex CLI executable name or path."
        },
        "countersign.claudeAllowedTools": {
          "type": "array",
          "default": [
            "Read",
            "Glob",
            "Grep",
            "Edit",
            "Write"
          ],
          "items": {
            "type": "string"
          },
          "description": "Legacy bounded Claude tool list; Full access uses the full built-in tool set and Ask before change uses per-tool prompts."
        },
        "countersign.localChecks": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "id",
              "executable",
              "args"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "executable": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "description": "Local checks explicitly configured as an executable and argument array. No shell is used."
        },
        "countersign.budgetGuardUsd": {
          "type": "number",
          "default": 1,
          "minimum": 0.01,
          "description": "Claude CLI estimated cost guard per print invocation; it does not guarantee a billing cap."
        },
        "countersign.taskTimeoutMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 180
        },
        "countersign.providerTimeoutMinutes": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "maximum": 60
        },
        "countersign.checkTimeoutMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 30
        },
        "countersign.findingThreshold": {
          "type": "string",
          "enum": [
            "Critical",
            "High",
            "Medium",
            "Low",
            "Info"
          ],
          "default": "High",
          "description": "Minimum finding severity eligible for Claude's single correction pass."
        },
        "countersign.terminationGracePeriodMs": {
          "type": "number",
          "default": 1000,
          "minimum": 100,
          "maximum": 10000,
          "description": "Grace period before terminating a provider or check process group with SIGKILL."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-rewrite-relative-links --allow-missing-repository",
    "lint": "eslint src tests",
    "test": "vitest run && npm run typecheck:tests",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "compile:integration": "tsc -p tsconfig.integration.json",
    "test:integration": "npm run compile && npm run compile:integration && node .integration-dist/tests/integration/runIntegration.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "4.0.0",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.306"
  }
}
