{
  "name": "countersign",
  "displayName": "Countersign",
  "description": "A local VS Code workflow for bounded Claude implementation and Codex review, with mock mode.",
  "version": "0.1.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:countersign.startWorkflow",
    "onCommand:countersign.cancelWorkflow",
    "onCommand:countersign.showStatus",
    "onCommand:countersign.showDiagnostics",
    "onCommand:countersign.verifyClaudeGate",
    "onCommand:countersign.showDiff",
    "onCommand:countersign.showReview",
    "onCommand:countersign.showCheckResults"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "countersign.startWorkflow",
        "title": "Countersign: Start Workflow"
      },
      {
        "command": "countersign.cancelWorkflow",
        "title": "Countersign: Cancel Workflow"
      },
      {
        "command": "countersign.showStatus",
        "title": "Countersign: Show Workflow Status"
      },
      {
        "command": "countersign.showDiagnostics",
        "title": "Countersign: Show Diagnostics"
      },
      {
        "command": "countersign.verifyClaudeGate",
        "title": "Countersign: Verify Claude Settings Isolation"
      },
      {
        "command": "countersign.showDiff",
        "title": "Countersign: Show Workflow Diff"
      },
      {
        "command": "countersign.showReview",
        "title": "Countersign: Show Review Details"
      },
      {
        "command": "countersign.showCheckResults",
        "title": "Countersign: Show Check Results"
      }
    ],
    "configuration": {
      "title": "Countersign",
      "properties": {
        "countersign.provider": {
          "type": "string",
          "enum": [
            "mock",
            "claude"
          ],
          "default": "mock",
          "description": "Implementation provider. Real Claude requires a successful settings-source isolation test for its exact CLI version."
        },
        "countersign.codexProvider": {
          "type": "string",
          "enum": [
            "mock",
            "real"
          ],
          "default": "mock",
          "description": "Review provider. The real Codex CLI uses exec with the read-only sandbox and may consume account quota."
        },
        "countersign.claudeExecutable": {
          "type": "string",
          "default": "claude",
          "description": "Claude CLI executable name or path. Real execution requires an exact-version settings-source gate."
        },
        "countersign.codexExecutable": {
          "type": "string",
          "default": "codex",
          "description": "Codex CLI executable name or path."
        },
        "countersign.mockScenario": {
          "type": "string",
          "enum": [
            "clean",
            "finding",
            "noChanges",
            "error"
          ],
          "default": "clean",
          "description": "Mock-only scenario used by the workflow."
        },
        "countersign.claudeAllowedTools": {
          "type": "array",
          "default": [
            "Read",
            "Glob",
            "Grep",
            "Edit",
            "Write"
          ],
          "items": {
            "type": "string"
          },
          "description": "Explicit Claude tool allowlist shown before a task. Bash is not supported."
        },
        "countersign.localChecks": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "id",
              "executable",
              "args"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "executable": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "description": "Local checks explicitly configured as an executable and argument array. No shell is used."
        },
        "countersign.budgetGuardUsd": {
          "type": "number",
          "default": 1,
          "minimum": 0.01,
          "description": "Claude CLI estimated cost guard per print invocation; it does not guarantee a billing cap."
        },
        "countersign.taskTimeoutMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 180
        },
        "countersign.providerTimeoutMinutes": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "maximum": 60
        },
        "countersign.checkTimeoutMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 30
        },
        "countersign.findingThreshold": {
          "type": "string",
          "enum": [
            "Critical",
            "High",
            "Medium",
            "Low",
            "Info"
          ],
          "default": "High",
          "description": "Minimum finding severity eligible for Claude's single correction pass."
        },
        "countersign.terminationGracePeriodMs": {
          "type": "number",
          "default": 1000,
          "minimum": 100,
          "maximum": 10000,
          "description": "Grace period before terminating a provider or check process group with SIGKILL."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "vscode:prepublish": "npm run compile",
    "package": "npm run compile",
    "lint": "eslint src tests",
    "test": "vitest run && npm run typecheck:tests",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "compile:integration": "tsc -p tsconfig.integration.json",
    "test:integration": "npm run compile && npm run compile:integration && node .integration-dist/tests/integration/runIntegration.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^10.13.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  }
}
